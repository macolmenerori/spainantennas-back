{
  "name": "spainantennas-back",
  "version": "1.0.0",
  "description": "Backend of spainantennas project",
  "main": "dist/server.js",
  "author": "macolmenerori",
  "repository": {
    "type": "git",
    "url": "https://github.com/macolmenerori/spainantennas-back.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --exec tsx src/server.ts",
    "lint": "eslint --fix .",
    "prettify": "prettier -w --log-level=silent .",
    "types": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm audit --prod && pnpm lint && pnpm prettify && pnpm types && pnpm test && pnpm build",
    "generate:openapi": "tsx scripts/generateOpenapi.ts",
    "generate:openapi:json": "tsx scripts/generateOpenapi.ts --json"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@exortek/express-mongo-sanitize": "^4.0.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "mongoose": "^9.12.2",
    "multer": "^2.5.0",
    "swagger-jsdoc": "^6.3.0",
    "yaml": "^2.9.1"
  }
}
