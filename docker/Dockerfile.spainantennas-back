FROM node:26-alpine AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV CI=true
RUN npm install -g corepack && corepack enable && apk add --no-cache git

WORKDIR /app
RUN git clone https://github.com/macolmenerori/spainantennas-back.git .

# Generate config.env from build args
ARG NODE_ENV=production
ARG PORT=8083
ARG DATABASE
ARG AUTH_URL
ARG AUTH_TIMEOUT_MS=10000
ARG RATELIMIT_MAXCONNECTIONS=1000
ARG RATELIMIT_WINDOWMS=900000
ARG CORS_WHITELIST
ARG DEFAULT_PERPAGE=20
ARG MAX_PERPAGE=100
ARG IMPORT_MAX_SIZE_MB=100
RUN printf "NODE_ENV=%s\nPORT=%s\nDATABASE=%s\nAUTH_URL=%s\nAUTH_TIMEOUT_MS=%s\nRATELIMIT_MAXCONNECTIONS=%s\nRATELIMIT_WINDOWMS=%s\nCORS_WHITELIST=%s\nDEFAULT_PERPAGE=%s\nMAX_PERPAGE=%s\nIMPORT_MAX_SIZE_MB=%s\n" \
  "$NODE_ENV" "$PORT" "$DATABASE" "$AUTH_URL" "$AUTH_TIMEOUT_MS" "$RATELIMIT_MAXCONNECTIONS" "$RATELIMIT_WINDOWMS" "$CORS_WHITELIST" "$DEFAULT_PERPAGE" "$MAX_PERPAGE" "$IMPORT_MAX_SIZE_MB" > config.env

FROM base AS prod-deps
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --prod --frozen-lockfile

FROM base AS build
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile
RUN pnpm run build

FROM node:26-alpine
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV CI=true
RUN npm install -g corepack && corepack enable
WORKDIR /app
COPY --from=base /app/package.json /app/pnpm-lock.yaml ./
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=base /app/config.env ./
EXPOSE 8083
HEALTHCHECK --interval=120s --retries=2 --start-period=5m --timeout=30s CMD wget -q -O- http://localhost:8083/healthcheck || exit 1
CMD ["pnpm", "start"]
